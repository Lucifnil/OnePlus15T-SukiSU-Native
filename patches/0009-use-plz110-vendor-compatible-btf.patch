diff --git a/scripts/link-vmlinux.sh b/scripts/link-vmlinux.sh
--- a/scripts/link-vmlinux.sh
+++ b/scripts/link-vmlinux.sh
@@ -117,6 +117,16 @@ gen_btf()
 	# objcopy warnings: "empty loadable segment detected at ..."
 	${OBJCOPY} --only-section=.BTF --set-section-flags .BTF=alloc,readonly \
 		--strip-all ${1} "${btf_data}" 2>/dev/null
+	# PLZ110's shipping sched_ext module carries split BTF whose base IDs must
+	# remain identical to the pristine official-source GKI.  The compatibility
+	# blob is generated by that exact pinned source and toolchain.
+	btf_base="${srctree}/scripts/plz110-vendor-base.btf"
+	if [ ! -r "${btf_base}" ]; then
+		echo >&2 "BTFBASE missing: ${btf_base}"
+		exit 1
+	fi
+	info BTFBASE "${btf_base}"
+	${OBJCOPY} --update-section .BTF="${btf_base}" "${btf_data}"
 	# Change e_type to ET_REL so that it can be used to link final vmlinux.
 	# GNU ld 2.35+ and lld do not allow an ET_EXEC input.
 	if is_enabled CONFIG_CPU_BIG_ENDIAN; then
